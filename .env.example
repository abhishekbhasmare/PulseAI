# PulseAI Healthcare Continuity Platform - Environment Configuration (Optional)
# The core MVP functions 100% locally with ₹0 mandatory spend and zero required external keys.

# Optional: Supabase PostgreSQL Cloud Backend (if migrating beyond demo local storage)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# Optional: Free-tier External AI Provider for TrustGuard (Falls back to deterministic local rule engine if not set)
# Never expose backend secrets or service-role keys in VITE_ client variables
VITE_USE_LOCAL_TRUSTGUARD=true
